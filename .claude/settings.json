{
  "permissions": {
    "allow": [
      "mcp__Meta_Ads__ads_get_ad_entities",
      "mcp__Meta_Ads__ads_account_get_activity_logs",
      "mcp__Meta_Ads__ads_update_entity",
      "mcp__Meta_Ads__ads_activate_entity"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__Meta_Ads__ads_update_entity|mcp__Meta_Ads__ads_activate_entity",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/meta-ads-guard.sh\"",
            "timeout": 10,
            "statusMessage": "Checking Meta Ads guard..."
          }
        ]
      }
    ]
  }
}
